* {
    font: "JetBrainsMono Nerd Font 14";
    background-color: transparent;
    text-color: #dbeafe;
    border-color: #60a5fa;
}

window {
    width: 680px;
    padding: 24px;
    background-color: rgba(20, 20, 20, 0.1);
    border: 3px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 20px;
}

mainbox {
    spacing: 18px;
}

inputbar {
    padding: 14px 18px;
    background-color: rgba(20, 20, 20, 0.1);
    border: 3px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 20px;
}

prompt {
    text-color: #60a5fa;
}

entry {
    text-color: #e0f2fe;
}

listview {
    spacing: 6px;
    padding: 8px;
}

element {
    padding: 12px 16px;
    border-radius: 12px;
    background-color: transparent;
}

element selected.normal {
    background-color: rgba(20, 20, 20, 0.35);
    text-color: #07101f;
}

element-icon {
    size: 22px;
}

element hover {
    background-color: #1e40af;
}
