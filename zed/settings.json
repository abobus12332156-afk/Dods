// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "ollama": {
      "api_url": "http://127.0.0.1:11434"
    }
  },
  "agent": {
    "default_profile": "write",
    "instructions": "Называй пользователя на 'ты', используй ТОЛЬКО русский язык и отвечай ТОЛЬКО на нём.",
    "single_file_review": false,
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "search_web": {
          "default": "allow"
        },
        "write_file": {
          "default": "allow"
        },
        "edit_file": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "effort": "minimal",
      "provider": "google",
      "model": "gemini-3.5-flash-lite",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "lsp_highlight_debounce": 0,
  "prettier": {
    "allowed": true
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_weight": 100.0,
  "buffer_font_family": "MesloLGM Nerd Font",
  "autosave": "on_window_change",
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Espresso (Blur)",
  },
}
